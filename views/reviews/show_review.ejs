<div class="row">
    <div class="col-md-6 col-es-12 offset-md-3">
        <hr>
        <p><b>All Reviews</b></p>
        <div class="row">
            <% for(let review of listing.reviews) {%>
                <div class="card review-card col-sm-5 col-es-12  ms-md-3 mb-3 ">
                    <div class="card-body">
                        <p class="card-title">@ <b>
                                <%= review.created_by.username %>
                            </b></p>
                        <p class="starability-result card-text" data-rating="<%= review.rating %>">
                            <%= review.rating %>
                        </p>
                        <p class="card-text mb-3">
                            <%= review.comment %>
                        </p>
                        <% if(currUser && currUser._id.equals(review.created_by._id)) {%>
                            <form method="POST"
                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                <button>Delete</button>
                            </form>
                            <% } %>
                    </div>
                </div>
                <% } %>
        </div>
    </div>
</div>