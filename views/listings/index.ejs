<% layout("/layout/boilerplate") %>


    <div id="filters">
        <button class="btn" onclick="scrolledLeft()">◀</button>

        <div id="slider" class="icon-row">

            <a href="/listings/filter?type=Tranding">
                <div class="filter">
                    <div><i class="fa-solid fa-fire"></i></div>
                    <p>Tranding</p>
                </div>
            </a>

            <a href="/listings/filter?type=Rooms">
                <div class="filter">
                    <div><i class="fa-solid fa-bed"></i></div>
                    <p>Rooms</p>
                </div>
            </a>

            <a href="/listings/filter?type=Iconic+Cities">
                <div class="filter">
                    <div><i class="fa-solid fa-mountain-city"></i></div>
                    <p>Iconic Cities</p>
                </div>
            </a>

            <a href="/listings/filter?type=Mountains">
                <div class="filter">
                    <div><i class="fa-solid fa-mountain"></i></div>
                    <p>Mountains</p>
                </div>
            </a>

            <a href="/listings/filter?type=Castles">
                <div class="filter">
                    <div><i class="fa-brands fa-fort-awesome"></i></div>
                    <p>Castles</p>
                </div>
            </a>

            <a href="/listings/filter?type=Amazing+Pools">
                <div class="filter">
                    <div><i class="fa-solid fa-person-swimming"></i></div>
                    <p>Amazing Pools</p>
                </div>
            </a>

            <a href="/listings/filter?type=Capming">
                <div class="filter">
                    <div><i class="fa-solid fa-campground"></i></div>
                    <p>Capming</p>
                </div>
            </a>

            <a href="/listings/filter?type=Farms">
                <div class="filter">
                    <div><i class="fa-solid fa-cow"></i></div>
                    <p>Farms</p>
                </div>
            </a>

            <a href="/listings/filter?type=Arctic">
                <div class="filter">
                    <div><i class="fa-solid fa-snowflake"></i></div>
                    <p>Arctic</p>
                </div>
            </a>

            <a href="/listings/filter?type=Domes">
                <div class="filter">
                    <div><i class="fa-solid fa-igloo"></i></div>
                    <p>Domes</p>
                </div>
            </a>

            <a href="/listings/filter?type=Boats">
                <div class="filter">
                    <div><i class="fa-solid fa-ferry"></i></div>
                    <p>Boats</p>
                </div>
            </a>

            <div class="tax-toggler ms-auto">
                <div class="form-check-reverse form-switch ">
                    <input class="form-check-input " type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label " for="switchCheckDefault">Display total after</label>
                </div>
            </div>
        </div>
        <button class="btn" onclick="scrollRight()">▶</button>
    </div>


    <body>
        <div class="row row-cols-xxl-4 row-cols-lg-3 row-cols-md-2 row-cols-sm-1">

            <% for(let listing of allListings) { %>
                <a href="/listings/<%= listing._id %>" class="listing-link">

                    <div class="card col">
                        <img src="<%= listing.image.Url %>" class="card-img-top" alt="listing_img"
                            style="height: 15rem">
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text"><b>
                                    <%= listing.title %>
                                </b><br>
                                &#8377; <%= listing.price %>/ night
                                    <i class="tax-info">&nbsp; +18% GST</i></p>
                        </div>
                    </div>

                </a>
                <% } %>
        </div>
    </body>

    <script>
        let taxSwitch = document.getElementById("switchCheckDefault");
        taxSwitch.addEventListener("click", () => {
            let taxInfo = document.getElementsByClassName("tax-info");
            for (info of taxInfo) {
                if (info.style.display != "inline") {
                    info.style.display = "inline";
                } else {
                    info.style.display = "none";
                }
            }
        })


        function scrolledLeft() {
            document.getElementById("slider").scrollBy({ left: -100, behavior: "smooth" });
        }

        function scrollRight() {
            document.getElementById("slider").scrollBy({ left: 100, behavior: "smooth" });
        }
    </script>