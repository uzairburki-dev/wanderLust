<%- layout("layout/boilerplate") %>

    <div>
        <div class="row mt-3">
            <div class="col-md-8 offset-md-2">
                <h2>Create a New Listing</h2>
                <form method="Post" action="/listings" class="needs-validation" novalidate
                    enctype="multipart/form-data">

                    <div class="row g-3">

                        <!-- Title -->
                        <div class="col-lg-4">
                            <label for="title" class="form-label fw-semibold">Title</label>
                            <input id="title" class="form-control custom-input" name="listing[title]"
                                placeholder="Add a catchy title" type="text" required>
                            <div class="invalid-feedback">This field is required.</div>
                        </div>

                        <!-- Category -->
                        <div class="col-lg-8">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="listing[Category]" class="form-select custom-select" required>
                                <option value="" selected disabled>Select Category</option>
                                <option value="Trending">Trending</option>
                                <option value="Rooms">Rooms</option>
                                <option value="Iconic Cities">Iconic Cities</option>
                                <option value="Mountains">Mountains</option>
                                <option value="Castles">Castles</option>
                                <option value="Amazing Pools">Pools</option>
                                <option value="Camping">Camping</option>
                                <option value="Farms">Farms</option>
                                <option value="Arctic">Arctic</option>
                                <option value="Domes">Domes</option>
                                <option value="Boats">Boats</option>
                            </select>
                        </div>

                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea id="description" class="form-control" name="listing[description]" required></textarea>
                        <div class="invalid-feedback">We need this information to continue.</div>
                    </div>

                    <div class="mb-3">
                        <label for="image" class="form-label">Upload Image</label>
                        <input class="form-control" id="image" name="listing[image]" type="file" required>
                    </div>

                    <div class="row">
                        <div class="mb-3 col-lg-4">
                            <label for="price" class="form-label">Price</label>
                            <input class="form-control" id="price" name="listing[price]" placeholder="7000"
                                type="number" required>
                            <div class="invalid-feedback">This field is required. Please add some information.</div>
                        </div>

                        <div class="mb-3 col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input class="form-control" id="country" name="listing[country]" placeholder="Afghanistan"
                                type="text" required>
                            <div class="invalid-feedback">Please fill out this field before continuing.</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label>
                        <input class="form-control" id="location" name="listing[location]" placeholder="Kabul"
                            type="string" required>
                        <div class="invalid-feedback">Please enter a value before submitting.</div>
                    </div>
                    <button class="btn btn-dark add-btn mt-3 mb-3">Add</button>
                </form>

            </div>
        </div>
        </body>